# Copy to .env on the VPS and fill in real values there. Never commit the
# real .env — it's gitignored (see .gitignore's `.env*` rule).

# Supabase project — public URL + publishable (anon) key, safe to expose to
# the client (Vite inlines VITE_* vars into the browser bundle at build time).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — server-only, never sent to the browser. Used
# by /api/ai-chat for chat rate-limit bookkeeping (chat_usage table).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only, never sent to the browser. Used by
# /api/ai-chat and /api/ai/generate-summary to call Claude Haiku 4.5.
ANTHROPIC_API_KEY=

# Public origin of the site, no trailing slash — used for canonical URLs,
# the sitemap, robots.txt and JSON-LD. OPTIONAL: defaults to
# https://pakclay.com. VITE_SITE_URL is read at BUILD time (client bundle and
# the prerender script); SITE_URL (or VITE_SITE_URL) is read by the server.
VITE_SITE_URL=https://pakclay.com

# Port the Express server listens on (Hostinger's hPanel Node.js App hosting
# assigns it itself). Defaults to 3000 if unset.
PORT=3000
