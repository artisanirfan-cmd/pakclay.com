# Reference Nginx server block for khaprail-website on the Hostinger VPS.
#
# This file is NOT applied automatically — copy the relevant parts into
# /etc/nginx/sites-available/khaprail.com.pk (or your domain's file) on the
# VPS itself, then `sudo ln -s /etc/nginx/sites-available/khaprail.com.pk
# /etc/nginx/sites-enabled/` and `sudo nginx -t && sudo systemctl reload nginx`.
#
# Replace `khaprail.com.pk` below with the real domain, and `3000` with
# PORT from .env if you changed it from the default.

# Plain HTTP — redirects to HTTPS once Certbot has issued a certificate.
# Certbot (see PART 4 notes in the task report) can rewrite this block
# automatically via `certbot --nginx`, or you can keep this manual version.
server {
    listen 80;
    listen [::]:80;
    server_name khaprail.com.pk www.khaprail.com.pk;

    # Uncomment once certbot has run, to force HTTPS:
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for the streamed /api/ai-chat response (Server-Sent-Events-
        # style chunked text) to reach the client without Nginx buffering the
        # whole thing before forwarding it.
        proxy_buffering off;
        proxy_cache off;

        # The Anthropic call inside /api/ai-chat can legitimately take tens of
        # seconds (streaming reply + a possible search_products follow-up
        # call) — keep these above the app's own internal timeouts
        # (ANTHROPIC_FETCH_TIMEOUT_MS / ANTHROPIC_STREAM_READ_TIMEOUT_MS in
        # server/routes/ai-chat.ts) so Nginx never cuts the connection first.
        proxy_connect_timeout 60s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }
}

# HTTPS — uncomment and fill in once Certbot (Let's Encrypt) has issued a
# certificate for this domain: `sudo certbot --nginx -d khaprail.com.pk -d www.khaprail.com.pk`
# Certbot can generate this block for you automatically; the manual version
# below is here for reference/rollback.
